# load packages
pacman::p_load( "vroom" )
# cargar data
minerales.df <- vroom( file = "minerales.tsv" )
View(minerales.df)
# cargar paquetes
pacman::p_load( "vroom", "ggplot2" )
View(minerales.df)
# cargar paquetes
pacman::p_load( "vroom", "ggplot2", "tidyr" )
# pasar a largo
minerales_long.df <- pivot_longer( data = minerales.df,
cols = -Commodity,
names_to = "year",
values_to = "toneladas" )
View(minerales_long.df)
# cargar paquetes
pacman::p_load( "vroom", "ggplot2", "tidyr", "dplyr" )
# pasar a largo
minerales_long.df <- pivot_longer( data = minerales.df,
cols = -Commodity,
names_to = "year",
values_to = "toneladas" ) %>%
rename( "mineral" = 1,
"anio" = 2 )
# graficar cambio en toneladas
ggplot( data = minerales.df,
mapping = aes( x = mineral,
y = toneladas,
fill = anio ) ) +
geom_col( )
# graficar cambio en toneladas
ggplot( data = minerales_long.df,
mapping = aes( x = mineral,
y = toneladas,
fill = anio ) ) +
geom_col( )
# graficar cambio en toneladas
ggplot( data = minerales_long.df,
mapping = aes( x = anio,
y = toneladas,
group = mineral ) ) +
geom_line( )
vroom_write( x = minerales_long.df, file = "minerales.tsv2" )
# cargar paquetes
pacman::p_load( "vroom", "ggplot2", "tidyr",
"dplyr", "" )
# cargar paquetes
pacman::p_load( "vroom", "ggplot2", "tidyr",
"dplyr" )
# cargar data
minerales.df <- vroom( file = "minerales.tsv" )
View(minerales.df)
# graficar cambio en toneladas
ggplot( data = minerales_long.df,
mapping = aes( x = anio,
y = toneladas,
group = mineral ) ) +
geom_line( )
# graficar cambio en toneladas
ggplot( data = minerales.df,
mapping = aes( x = anio,
y = toneladas,
group = mineral ) ) +
geom_line( )
# graficar cambio en toneladas
linea1.p <- ggplot( data = minerales.df,
mapping = aes( x = anio,
y = toneladas,
group = mineral ) ) +
geom_line( )
# ver la version fea
linea1.p
# mejoramos un poco
linea1.p +
theme_classic( )
# graficar cambio en toneladas
linea1.p <- ggplot( data = minerales.df,
mapping = aes( x = anio,
y = toneladas,
group = mineral,
color = mineral ) ) +
geom_line( )
# ver la version fea
linea1.p
# mejoramos un poco
linea1.p +
theme_classic( )
# graficar cambio en toneladas
linea1.p <- ggplot( data = minerales.df,
mapping = aes( x = anio,
y = log10( toneladas ),
group = mineral,
color = mineral ) ) +
geom_line( )
# ver la version fea
linea1.p
# mejoramos un poco
linea1.p +
theme_classic( )
# mejoramos un poco
linea1.p +
geom_point( ) +
theme_classic( )
View(minerales.df)
# cargar data
minerales.df <- vroom( file = "minerales.tsv" ) %>%
filter( mineral %in% c( "Bauxite",
"Aluminium",
"Copper",
"Zinc",
"Lead",
"Lithium",
"Antimony" ) )
# graficar cambio en toneladas
linea1.p <- ggplot( data = minerales.df,
mapping = aes( x = anio,
y = log10( toneladas ),
group = mineral,
color = mineral ) ) +
geom_line( )
# ver la version fea
linea1.p
# mejoramos un poco
linea1.p +
geom_point( ) +
theme_classic( )
# cargar paquetes
pacman::p_load( "vroom", "ggplot2", "tidyr",
"dplyr", "ggsci" )
# mejoramos un poco
linea1.p +
geom_point( ) +
scale_color_npg( ) +
theme_classic( )
# mejoramos un poco
linea1.p +
geom_point( ) +
scale_color_aaas( ) +
theme_classic( )
# graficar cambio en toneladas
linea1.p <- ggplot( data = minerales.df,
mapping = aes( x = anio,
y =  toneladas ,
group = mineral,
color = mineral ) ) +
geom_line( )
# ver la version fea
linea1.p
# mejoramos un poco
linea1.p +
geom_point( ) +
scale_color_aaas( ) +
theme_classic( )
source("~/Documents/public_datasets/cursos_especiales/edicion_graficos_cientificos/ejercicio_1/mineral.R", echo=TRUE)
